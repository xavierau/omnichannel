# ===========================================
# Backend Production Environment Variables
# ===========================================
# Copy this file to .env on the production server and fill in the values.
# DO NOT commit the actual .env file with secrets to git!

# Application Configuration
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://omnichannel.phbsolution.com

# Database Configuration (Forge PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnichannel_db
DATABASE_USER=forge
DATABASE_PASSWORD=your_secure_database_password

# Database Connection Pool Configuration
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_POOL_CONNECTION_TIMEOUT_MS=5000
DB_POOL_ACQUIRE_TIMEOUT_MS=60000
DB_STATEMENT_TIMEOUT_MS=30000
DB_RETRY_ATTEMPTS=3
DB_RETRY_DELAY_MS=1000

# JWT Configuration (generate secure random strings)
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=generate_secure_random_64_bytes_hex
JWT_REFRESH_SECRET=generate_different_secure_random_64_bytes_hex
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info

# Email Configuration (for password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@yourdomain.com

# AWS S3 Configuration (for media uploads)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-production-media-bucket
S3_SIGNED_URL_EXPIRY=3600
