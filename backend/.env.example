# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=omnichannel_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password_here

# Database Connection Pool Configuration (optional - sensible defaults provided)
# DB_POOL_MAX=20                     # Maximum number of connections in pool
# DB_POOL_MIN=5                      # Minimum number of connections in pool
# DB_POOL_IDLE_TIMEOUT_MS=30000      # Time (ms) before idle connection is released
# DB_POOL_CONNECTION_TIMEOUT_MS=5000 # Time (ms) to establish a new connection
# DB_POOL_ACQUIRE_TIMEOUT_MS=60000   # Max time (ms) to wait for available connection
# DB_STATEMENT_TIMEOUT_MS=30000      # Max time (ms) for a single query
# DB_RETRY_ATTEMPTS=3                # Number of connection retry attempts
# DB_RETRY_DELAY_MS=1000             # Delay (ms) between retry attempts

# JWT Configuration
JWT_ACCESS_SECRET=generate_with_crypto_randomBytes_64
JWT_REFRESH_SECRET=generate_with_crypto_randomBytes_64_different_from_access
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Application Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Logging
LOG_LEVEL=info

# Email Configuration (for password reset)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM=noreply@example.com
