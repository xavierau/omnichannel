{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "rootDir": "..",
    "baseUrl": "../src",
    "paths": {
      "@/*": ["*"],
      "@features/*": ["features/*"],
      "@middleware/*": ["middleware/*"],
      "@config/*": ["config/*"],
      "@shared/*": ["shared/*"],
      "@database/*": ["database/*"]
    }
  },
  "include": ["*.ts", "../src/**/*"],
  "ts-node": {
    "require": ["tsconfig-paths/register"]
  }
}
