# ===========================================
# Omnichannel Production Environment Config
# ===========================================

# Host port mapping (nginx will point to this port)
# Example: localhost:3012 -> container:3000
HOST_PORT=3012

# ===========================================
# Database Configuration (Native PostgreSQL)
# ===========================================
# PostgreSQL runs natively on the host for performance.
# Use host.docker.internal to connect from container to host.
# On Linux, you may need to use the host's actual IP address.
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_NAME=omnichannel_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your_secure_database_password_here

# ===========================================
# Redis Configuration (Native Redis)
# ===========================================
# Redis runs natively on the host for performance.
REDIS_HOST=host.docker.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ===========================================
# Application Configuration
# ===========================================
# Your production domain (used for CORS and cookies)
FRONTEND_URL=https://my-app.com

# Logging level: error, warn, info, debug
LOG_LEVEL=info

# ===========================================
# JWT Configuration (REQUIRED - Generate secure secrets!)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===========================================
JWT_ACCESS_SECRET=generate_64_byte_hex_secret_here
JWT_REFRESH_SECRET=generate_different_64_byte_hex_secret_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ===========================================
# Email Configuration (for password reset)
# ===========================================
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@your-domain.com

# ===========================================
# AWS S3 Configuration (for media uploads)
# ===========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=ap-southeast-1
S3_BUCKET_NAME=your-bucket-name
S3_SIGNED_URL_EXPIRY=3600
